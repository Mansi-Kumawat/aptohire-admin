{
  "name": "aptohire-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0 --port 5177 --strictPort",
    "build": "node scripts/validate-env.mjs && tsc -p tsconfig.json --noEmit && vite build --config vite.config.ts && node scripts/security-check.mjs --built",
    "preview": "vite preview --config vite.config.ts --host 0.0.0.0 --port 4177",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint frontend backend tests --max-warnings=0",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_REF > backend/src/database.types.ts",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.6",
    "@fontsource-variable/instrument-sans": "5.2.6",
    "@fontsource/jetbrains-mono": "5.2.6",
    "@supabase/supabase-js": "2.57.4",
    "@tanstack/react-query": "5.87.1",
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "2.0.5",
    "react-hook-form": "7.62.0",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
